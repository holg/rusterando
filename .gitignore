/target
hash.txt
*.db
*.db-shm
*.db-wal
.env
data/
node_modules/
tmp/
package-lock.json
.DS_Store


# Local-only secrets / scratch space (Apple Developer credentials,
# APNs auth key, scratch notes — see docs/apple_setup.md). Never commit.
.hidden/
*.p8
AuthKey_*.p8

# iOS app: the brand-neutral Rusterando target is tracked. Shop-
# specific bits (Team ID, applinks, seed plist) are gitignored via
# ios-app/.gitignore — see ios-app/project.yml + project.local.yml.

# Tauri legacy shell (archived, replaced by native Swift app).
src-tauri/

# Top-level img/ is the local scratch dir (raw photos, WhatsApp drops,
# work-in-progress). The published assets live under public/img/.
/img/

# Local plans + private notes — all docs/ stays out of the public repo.
# README.md (top-level) is the canonical public documentation; the
# docs/ tree holds deployment-specific notes.
docs/
.claude/

# .env.example with real secrets — replaced for the public repo by
# the placeholder version. Real one stays out.
.env.production
# Per-deployment env files (.env.<profile>, per-tenant .env.<profile>.<shop>)
# hold real Stripe / SMTP / APNs creds + shop URLs. Each operator keeps
# their own; never commit. Only the *.example files are tracked.
.env.*
!.env.example
!.env.*.example

# Per-deployment site overlays: a shop's own poster layouts, photos, AASA,
# seeds and tools live in site/<profile>/ and never go into the public
# repo. See site/README.md; scripts/deploy_to_server.sh ships them.
/site/*
!/site/README.md
!/site/example/

# rustc internal-compiler-error dumps (transient, machine-local).
rustc-ice-*.txt

# Generated / large binary artifacts — never in git (regenerated by the
# build or kept out-of-band). The demo screen-recording is ~1 GB.
menu.pdf
public/img/order-and-admin-demo.mov
public/img/rustlogos.png

# Menu-scraping tooling is developed out-of-tree (house rule: excluded
# from CI and the committed workspace).
rusterando-scrape/

# Old place of per-shop AASA files (real Apple TEAM_ID + bundle id); they
# now live in site/<profile>/apple-app-site-association. The placeholder
# at the real path is committed; per-shop variants never are.
public/.well-known/apple-app-site-association.*


# OTA printer artifacts (built binaries staged for in-band Pi self-update)
artifacts/

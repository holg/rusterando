[Unit]
Description=SSH tunnel: kitchen display -> server kitchen channel
# Not network-online: wait-online would delay boot ~2 min here (unplugged
# ports). Without a network dbclient just fails and Restart= retries in 5 s.
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/rusterando-printer/tunnel.env
# Dropbear's client (the board has no OpenSSH). Same forwards as the Pi:
#   -L 9001  the kitchen channel (server loopback only)
#   -R       admin SSH into this board from the server — only when
#            TUNNEL_ADMIN_PORT is set (empty while the Pi holds 2222)
# -K 15: keepalive every 15 s; Dropbear drops the link after a few missed
# replies, systemd restarts it. -I 0: no idle timeout. The host key is
# pinned in /home/root/.ssh/known_hosts (first connect, see README.md).
# `$$` = a literal `$` for sh (systemd would expand `$` itself).
ExecStart=/bin/sh -c 'exec /usr/bin/dbclient -N -T -K 15 -I 0 \
    -o ExitOnForwardFailure=yes \
    -i /etc/rusterando-printer/tunnel_key \
    -p "$$TUNNEL_PORT" \
    -L 127.0.0.1:9001:127.0.0.1:9001 \
    $${TUNNEL_ADMIN_PORT:+-R 127.0.0.1:$$TUNNEL_ADMIN_PORT:127.0.0.1:22} \
    "$$TUNNEL_TARGET"'

Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# /etc/rusterando-printer/tunnel.env — rusterando-tunnel.service
TUNNEL_TARGET=tunnel-davidspizzeria@davidspizzeria.de
TUNNEL_PORT=2200
# Server-side port that reaches this board's sshd (ssh -p PORT root@127.0.0.1
# on the server). Empty = no reverse forward. Leave empty while the Pi holds
# 2222 (a refused -R would kill the tunnel via ExitOnForwardFailure); after
# cutover set 2222, or 2223 with a matching permitlisten on the server.
TUNNEL_ADMIN_PORT=

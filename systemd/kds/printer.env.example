# /etc/rusterando-printer/printer.env — kitchen display (rusterando-kds.service)
#
# Default: DISPLAY ONLY. While the Pi still prints for this shop, the board
# must not print too (both would print every receipt). Cutover to printing
# here: PRINTER_PATH=usb and PRINTER_SHOP_SLUG=davidspizzeria (README.md).

# Kitchen channel via the SSH tunnel (rusterando-tunnel.service).
PRINTER_SERVER_ADDR=127.0.0.1:9001
PRINTER_SHOP_SLUG=davidspizzeria-kds
# none = display only · usb = first USB printer (no usblp on this kernel)
# · usb:VVVV:PPPP = that device (hex, see lsusb)
PRINTER_PATH=none
PRINTER_STATE_DIR=/var/lib/rusterando-printer
RUST_LOG=rusterando_printer=info

# Screen mounted upside down? 0 / 90 / 180 / 270.
#SLINT_KMS_ROTATION=180

# Screensaver: after this many idle seconds (no touch, no unstarted order)
# the screen goes to KDS_SAVER_CMD; a double tap or a new order brings the
# board back. No KDS_SAVER_CMD (or 0 s) = no saver. {touch} = touchscreen
# event device, for a saver that reads touch itself.
#KDS_SAVER_SECS=300
#KDS_SAVER_CMD=/usr/local/bin/my-kiosk --touch {touch}

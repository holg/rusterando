[Unit]
Description=Rusterando kitchen printer client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=holger
Group=lp

# The LIVE binary runs from the StateDirectory — the ONE writable path
# under ProtectSystem=strict — so it can self-update over the kitchen
# channel: the in-band updater atomically renames a verified new binary
# over this path and exits(0); systemd Restart=always relaunches the new
# one. /usr/local/bin/rusterando-printer is the bootstrap copy (initial
# deploy + manual --version); ExecStartPre seeds the writable copy from it
# whenever the bootstrap is newer (i.e. a fresh manual deploy), so a plain
# `deploy_printer.sh` still works and a manual deploy always wins.
ExecStartPre=/usr/bin/env sh -c 'L=/var/lib/rusterando-printer/bin/rusterando-printer; \
  B=/usr/local/bin/rusterando-printer; \
  if [ ! -x "$L" ] || [ "$B" -nt "$L" ]; then \
    install -D -m 755 -T "$B" "$L"; \
  fi; true'
ExecStart=/var/lib/rusterando-printer/bin/rusterando-printer
EnvironmentFile=/etc/rusterando-printer/printer.env

Restart=always
RestartSec=5

# Persistent state directory: idempotency cache lives in
# /var/lib/rusterando-printer/idempotency.json so we never double-print
# a receipt across a service restart or Pi reboot. systemd creates
# the dir if missing.
StateDirectory=rusterando-printer
StateDirectoryMode=0750

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rusterando-printer
# /dev/usb/lp0 is owned by root:lp 0660; supplementary group `lp`
# (above) is enough for write access. DeviceAllow constrains the
# cgroup so even a compromised binary can't talk to other devices.
DeviceAllow=/dev/usb/lp0 rw

[Install]
WantedBy=multi-user.target

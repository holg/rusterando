# The Tab5 with esp_hosted 2.x (BOARD=tab5-hosted2): for a C6 that runs
# esp_hosted 2.x firmware — e.g. after bmorcelli's Launcher updated it. The
# 1.4.0 line in Cargo.toml misreads that firmware's Wi-Fi events and
# registered the station interface twice ("netif already added", tab5-112233,
# 2026-11-15). scripts/build_kds_tab5.sh fills in @BOARD_DIR@ and points
# ESP_IDF_SYS_EXTRA_COMPONENTS_FILE at the result, which *replaces* the
# Tab5's list in Cargo.toml: otherwise the same components.

# Wi-Fi: the same esp_wifi_remote/esp_hosted pair as the JC1060P470 (whose
# C6 runs esp_hosted 2.3.0).
[[extra_components]]
remote_component = { name = "espressif/esp_wifi_remote", version = "==1.3.2" }

[[extra_components]]
remote_component = { name = "espressif/esp_hosted", version = "==2.11.0" }

[[extra_components]]
remote_component = { name = "espressif/esp_websocket_client", version = "==1.6.1" }

[[extra_components]]
remote_component = { name = "espressif/m5stack_tab5_noglib", version = "==1.3.2" }
bindings_header = "@BOARD_DIR@/../../src/bsp.h"
bindings_module = "bsp"

[[extra_components]]
component_dirs = "@BOARD_DIR@/../../../tab5-lab/components/lab_ble"
bindings_header = "@BOARD_DIR@/../../../tab5-lab/components/lab_ble/include/lab_ble.h"
bindings_module = "lab_ble"

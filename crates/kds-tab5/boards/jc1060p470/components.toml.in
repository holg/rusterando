# The JC1060P470's ESP-IDF components. scripts/build_kds_tab5.sh (with
# BOARD=jc1060p470) fills in @BOARD_DIR@ and points
# ESP_IDF_SYS_EXTRA_COMPONENTS_FILE at the result, which *replaces* the
# Tab5's list in Cargo.toml (esp-idf-sys wants absolute paths here).

# Wi-Fi (the hotspot): the P4 has no radio; esp_wifi_remote forwards the
# esp_wifi API over SDIO (esp_hosted) to the board's ESP32-C6. Its factory
# firmware is esp_hosted 2.3.0; Guition's own firmware pairs it with host
# 2.11.0 (logs a version warning, works), so the same here. Not the Tab5's
# 1.4.0: that line predates the C6's firmware.
[[extra_components]]
remote_component = { name = "espressif/esp_wifi_remote", version = "==1.3.2" }

[[extra_components]]
remote_component = { name = "espressif/esp_hosted", version = "==2.11.0" }

# The print channel (/api/kitchen/ws), as on the Tab5.
[[extra_components]]
remote_component = { name = "espressif/esp_websocket_client", version = "==1.6.1" }

# The board package: panel, touch, backlight, USB host, Ethernet — the same
# function names as Espressif's board packages, so the shared Rust code
# (display.rs, ui.rs, usb_printer.rs) runs unchanged. Rust bindings in
# esp_idf_svc::sys::bsp, as for the Tab5.
[[extra_components]]
component_dirs = "@BOARD_DIR@/bsp"
bindings_header = "@BOARD_DIR@/bsp.h"
bindings_module = "bsp"

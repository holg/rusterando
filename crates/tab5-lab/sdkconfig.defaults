# M5Stack Tab5: ESP32-P4 rev v1.3, 16 MB flash, 32 MB PSRAM — the same
# chip settings as crates/kds-tab5/sdkconfig.defaults (reasons there).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MEMTEST=n

# Console: UART0 primary, USB-Serial/JTAG (the USB-C port) secondary.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FREERTOS_HZ=1000

# The board package and the keyboard use ESP-IDF's new I2C master driver;
# esp-idf-hal links the legacy one. Never use esp-idf-hal's I2cDriver.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BSP_ERROR_CHECK=n

# Module13.2 LAN: W5500 on the M5-Bus SPI (ESP-IDF's own driver).
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
# DHCP: ask for the last address straight away.
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y

# `lan get https://…`: Mozilla's CA bundle (ESP-IDF default, made explicit).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# The ESP32-C6 coprocessor over SDIO (esp_hosted), wired as on the Tab5 —
# as in crates/kds-tab5/sdkconfig.defaults.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# Bluetooth LE: NimBLE host here, the C6's controller over esp_hosted
# (esp_hosted's host_nimble_bleprph_host_only_vhci example).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# A peripheral only (the phone is the central).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

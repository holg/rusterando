# Copy to .env. Never commit the real .env (it's gitignored).

# Target deployment. e.g. https://your-shop.example or local dev.
BASE_URL=http://127.0.0.1:3001

# Admin password for the target deployment. Required — tests fail fast
# if missing rather than hanging on a login screen.
DPE2E_ADMIN_PW=

# --- Optional: voucher-checkout E2E ---------------------------------------
# The phone-bound-voucher test needs a configured menu item, customer,
# and voucher in the target DB. Skips itself when these are unset.
#
# DPE2E_ITEM_ID=mi-…                  menu_items.id of the item to add
# DPE2E_ITEM_EXTRAS=ex-foo,ex-bar     comma-separated pizza_extras.id list
# DPE2E_ITEM_QTY=1
# DPE2E_EXPECTED_SUBTOTAL_CENTS=1600  expected cart subtotal after seed
# DPE2E_CUSTOMER_PHONE=…              a known customer (recall must find them)
# DPE2E_EXPECTED_STREET_PREFIX=Muster  optional: first chars of their address
# DPE2E_EXPECTED_POSTCODE=12345        optional: their postcode
# DPE2E_VOUCHER_CODE=…                fixed-amount voucher bound to that phone,
#                                     large enough to cap (subtotal + delivery)
#                                     to 0 €.

# --- Optional: browser + visibility -----------------------------------------
# Run with a visible browser window (true/false). Default = headless
# (headless is always the default when this is unset).
# HEADLESS=false
#
# Record two-browser tests to side-by-side video (1/0). Default = off.
# Most useful with HEADLESS=false (headless captures little). Output lands
# in tests/e2e/recordings/<run>/ (gitignored).
# RECORD=1
#
# Browser to drive. Engines: chromium | firefox | webkit.
# Channels (chromium-engine flavours): chrome | msedge | chrome-beta | msedge-beta.
# Default = chromium (Playwright's bundled build).
# BROWSER=chrome
#
# Artificial millisecond delay between every Playwright action. Useful
# with HEADLESS=false to watch what the test is doing.
# SLOWMO=300

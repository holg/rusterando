# =============================================================================
# Rusterando demo deployment — rusterando.de
#
# Copy this file to `.env.demo` (gitignored) and fill in the secrets.
# Then deploy with: ./scripts/deploy_to_server.sh -e demo full
#
# This deployment runs on the SAME VPS as Davids (same SSH_HOST), but
# binds a different localhost port + uses its own DB + html dir + binary
# name + systemd unit. nginx routes rusterando.de → 127.0.0.1:3002 and
# davidspizzeria.de → 127.0.0.1:3001.
# =============================================================================

# ----- Naming + paths ------------------------------------------------------
APP_NAME=rusterando-server
BIN_NAME=rusterando-server
LEPTOS_OUTPUT_NAME=rusterando

# Different port from Davids (3001) — nginx vhosts route by hostname.
LEPTOS_SITE_ADDR=127.0.0.1:3002

# Same SSH host as Davids; different on-server base dir.
SSH_HOST=<same as .env.davids>
DEPLOY_REMOTE_BASE=/var/www/rusterando.de

# ----- Database ------------------------------------------------------------
DATABASE_URL=sqlite:./data/rusterando.db

# ----- Public URL (used for QR codes, emails, Stripe return URL) ----------
PUBLIC_URL=https://rusterando.de

# ----- Auth ---------------------------------------------------------------
# Different passwords from prod. Demo site is public-readable so set a
# memorable but non-trivial admin password.
ADMIN_PASSWORD=<set me>
KITCHEN_PASSWORD=<set me>
DRIVER_PASSWORD=<set me>

# ----- Stripe (optional — leave empty for cash-only demo) -----------------
STRIPE_PUBLISH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- SMTP (optional — log-only without) ---------------------------------
# Re-use Davids' SMTP creds for the demo if you want order emails to land
# in your inbox; otherwise leave empty and the LogNotifier prints to
# journalctl instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ----- Apple Push Notifications (skip — demo doesn't have an iOS app) -----
# Leave empty so APNs is silently disabled.

# ----- Routing (optional — enables driver tour optimisation) --------------
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
PIZZERIA_LAT=0.0
PIZZERIA_LON=0.0

# ----- Logging ------------------------------------------------------------
RUST_LOG=info,sqlx=warn

# =============================================================================
# Rusterando — example .env
#
# Copy to `.env` and fill in your shop's values. The same file is read at
# build time (by `scripts/deploy_to_server.sh`) and at runtime (by the
# server via `dotenvy`). Required keys are marked; everything else degrades
# gracefully (no Stripe key → cash-only; no SMTP → log-only; no APNs → no
# push).
# =============================================================================

# ----- Naming + paths --------------------------------------------------------
# APP_NAME drives the binary filename on disk and the systemd unit name.
# The cargo build always produces `rusterando-server`; the deploy script
# rsyncs it to `$APP_NAME` on the server, so this can stay stable across
# upstream renames.
APP_NAME=rusterando-server
BIN_NAME=rusterando-server                  # alias for APP_NAME

# JS/WASM bundle name in target/site/pkg/<name>.<hash>.js. Setting this
# stable across deploys keeps existing browser caches valid.
LEPTOS_OUTPUT_NAME=rusterando

# Where the deploy script ssh-rsyncs to.
SSH_HOST=user@your-host.example.com
DEPLOY_REMOTE_BASE=/var/www/your-shop.example.com

# ----- Database --------------------------------------------------------------
DATABASE_URL=sqlite:./data/rusterando.db

# ----- Tenancy mode (single vs in-process multi-tenant) ----------------------
# MULTI_TENANT selects how this process serves shops:
#   0 / unset  -> SINGLE-TENANT (the default; real shops like davidspizzeria).
#                 One DB (DATABASE_URL above), one shop. This is the safe
#                 default — a real shop NEVER becomes multi-tenant by accident.
#   1          -> MULTI-TENANT (the rusterando showroom). One process serves
#                 many tenants; each tenant is a `<this-file>.<slug>` sibling
#                 with its own DB, resolved per request from the nginx
#                 `X-Tenant` header (or the Host subdomain locally).
#
# How tenants are discovered: the ACTIVE env file is the parent. Pick it with
# `ENV_FILE=.env.rusterando cargo leptos watch` (or pass it to the server).
# Then `.env.rusterando.*` are its tenants — e.g. `.env.rusterando.flizza`
# serves `flizza.rusterando.de` (slug `flizza`, db from ITS DATABASE_URL).
# `.env.rusterando` itself is the apex/landing (not a tenant).
#
#   ENV_GLOB    (optional) override which files count, e.g. `.env.rusterando*`.
#   ADMIN_TOKEN (multi only) gates `POST /admin/tenant/<slug>/reload` hot-add.
MULTI_TENANT=0

# ----- Server bind address ---------------------------------------------------
LEPTOS_SITE_ADDR=127.0.0.1:3001
PUBLIC_URL=https://your-shop.example.com

# ----- Shop timezone (IMPORTANT on a UTC VPS) --------------------------------
# Opening hours, pickup slots and "open now" are computed against the
# process-local time. A bare VPS runs in UTC, so a German shop's
# "17:00–22:00" would fire two hours off. Set the shop's IANA timezone so
# DST (MEZ↔MESZ) is handled automatically. The deploy script bakes this
# into the systemd unit (Environment=TZ=...); set it here to override.
TZ=Europe/Berlin

# ----- Auth (REQUIRED) -------------------------------------------------------
# Plaintext passwords — set long random strings on prod. Leave defaults
# only on a fully-isolated dev box.
ADMIN_PASSWORD=change-me
KITCHEN_PASSWORD=change-me
DRIVER_PASSWORD=change-me
# Platform operator login for /sysadmin on the APEX host (multi-tenant parent
# .env only): the Lieferando import wizard that scrapes a shop server-side and
# provisions the tenant. Unset = /sysadmin login impossible.
#SYS_ADMIN_PASSWORD=change-me
# Tooling the wizard spawns (defaults match the production layout; only set
# to override): the scraper's Playwright venv interpreter, the scraper, the
# menu-import binary and the scratch dir for scraped JSON.
#SCRAPER_PYTHON=rusterando-scrape/env_play_pdf_py12/bin/python
#SCRAPER_SCRIPT=rusterando-scrape/scrape_lieferando.py
#MENU_IMPORT_BIN=./menu-import-linux-x64
#IMPORT_TMP_DIR=tmp/imports
# Finished scrapes are kept here as menu-<slug>.json (same as the CLI) and
# imported from there — hand-edit between "Scrapen" and "Shop anlegen".
#MENU_JSON_DIR=rusterando-scrape/menu-json
# The service user (www-data) can't read root's ~/.cache/ms-playwright. Install
# the browsers where the service can read them and point Playwright at it:
#   sudo -u www-data PLAYWRIGHT_BROWSERS_PATH=/var/www/rusterando.de/.cache/ms-playwright \
#     rusterando-scrape/env_play_pdf_py12/bin/playwright install chromium
#PLAYWRIGHT_BROWSERS_PATH=/var/www/rusterando.de/.cache/ms-playwright

# ----- Stripe (optional, cash-only without) ---------------------------------
STRIPE_PUBLISH_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- SMTP (optional, log-only fallback) -----------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=bestellung@your-shop.example.com
SMTP_PASS=...
EMAIL_FROM=bestellung@your-shop.example.com

# ----- Apple Push Notifications (optional) ----------------------------------
# Get APNS_TEAM_ID, APNS_KEY_ID, APNS_KEY_PATH from Apple Developer →
# Certificates, IDs & Profiles → Keys. APNS_BUNDLE_ID is your iOS app's
# bundle id (must match the AASA file). APNS_PRODUCTION=false during dev.
APNS_TEAM_ID="<10-char team id>"
APNS_KEY_ID="<10-char key id>"
APNS_BUNDLE_ID=com.example.shop
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_PRODUCTION=false

# ----- Routing (optional, used by driver tour optimisation) -----------------
# OpenRouteService API key (free tier sufficient for one shop). The lat/lon
# is the shop's location — tour starts and ends here.
ORS_API_KEY="<your ORS api key>"
ORS_BASE_URL=https://api.openrouteservice.org
PIZZERIA_LAT=0.0
PIZZERIA_LON=0.0

# ----- Local address lookup (optional, NRW only in phase 1) --------------------
# Replaces the OpenStreetMap/Nominatim address check with an in-process index
# built from the official NRW cadastre (Gebäudereferenzen, licence dl-de/zero).
# Street + house-number autocomplete in the checkout, exact coordinates, no
# outbound request, no customer address leaves the server. Unset = the
# Nominatim behaviour stays. Import with `geo-import --tenant <slug> --download`,
# then switch the mode in /admin/zones → Adressprüfung. See docs/geo.md.
#GEO_BACKEND=cadastre_nrw
# Municipality keys (AGS, 8 digits) in the delivery area, comma-separated.
# Default only — the dashboard (Liefergebiete → Adressprüfung → Gemeinden)
# overrides this per shop, same for GEO_POSTCODE_MAP and PIZZERIA_LAT/LON.
#GEO_AGS=05558024
# AGS:PLZ:City triples (the cadastre file has no postcodes).
#GEO_POSTCODE_MAP=05558024:59348:Lüdinghausen
# Download cache for the ~100 MB export.
#GEO_DATA_DIR=./data/geo
# Optional import sanity box lat_min,lat_max,lon_min,lon_max (default: NRW).
# Default only — "Alles aus Adresse einrichten" stores one around the shop.
#GEO_EXPECT_BBOX=51.68,51.86,7.30,7.58

# ----- Logging ---------------------------------------------------------------
RUST_LOG=info,sqlx=warn
